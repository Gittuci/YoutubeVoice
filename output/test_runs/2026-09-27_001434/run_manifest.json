  "captions": [
    {
      "index": 1,
      "start": 1.0,
      "end": 4.34,
      "text": "A kiszabott hatszög közepére igazítjuk\naz átlátszó sablont,"
    },
    {
      "index": 2,
      "start": 4.52,
      "end": 7.54,
      "text": "majd a nyílásokon át két gombostűvel\nrögzítjük,"
    },
    {
      "index": 3,
      "start": 7.58,
      "end": 9.78,
      "text": "hogy hajtogatás közben\nne csússzon el."
    },
    {
      "index": 4,
      "start": 16.17,
      "end": 19.97,
      "text": "A széleken maradt varrásráhagyást\nsorban a sablonra hajtjuk."
    },
    {
      "index": 5,
      "start": 20.13,
      "end": 27.75,
      "text": "A sarkoknál az egymásra kerülő textilrétegeket\napró kézi öltésekkel fogjuk össze;\na tű csak a textilen halad át."
    },
    {
      "index": 6,
      "start": 47.01,
      "end": 49.71,
      "text": "A darabot folyamatosan forgatva\nhaladunk körbe."
    },
    {
      "index": 7,
      "start": 49.85,
      "end": 55.73,
      "text": "Minden új oldalt a sablon élére simítunk,\nmajd a következő saroknál rögzítjük a hajtást."
    },
    {
      "index": 8,
      "start": 73.201,
      "end": 78.121,
      "text": "Amikor körbeértünk, elvágjuk a cérnát,\nés kihúzzuk a két rögzítőtűt."
    },
    {
      "index": 9,
      "start": 78.261,
      "end": 83.161,
      "text": "A sablon ekkor még a textilben marad,\na behajtott hatszögelem pedig elkészült."
    }
  ],
